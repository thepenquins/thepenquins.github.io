---
import { filterHref } from "../data/games";

interface Props {
  items: string[];
  type: "genre" | "author";
}

const { items, type } = Astro.props;
const groups = 8;
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {
      Array.from({ length: groups }).map(() => (
        <div class="marquee__group" data-marquee-group>
          {items.map((item) => (
            <span class="marquee__item">
              <a class="strip-chip" href={filterHref(type, item)} tabindex="-1">
                {item}
              </a>
              <i aria-hidden="true">✦</i>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
