---
import { formatLanguages, type Game } from "../data/games";

interface Props {
  game: Game;
  index?: number;
}

const { game, index = 0 } = Astro.props;
---

<a
  class="game-card"
  href={`/games/${game.slug}/`}
  style={`--i:${index}`}
  data-game
  data-genre={game.genre}
  data-authors={game.credits.join("|")}
  data-search={[
    game.title,
    game.tagline,
    game.description.join(" "),
    game.genre,
    game.engine,
    game.platforms.join(" "),
    game.languages.join(" "),
    formatLanguages(game.languages),
    game.jam ?? "",
    game.credits.join(" "),
  ]
    .join(" ")
    .toLowerCase()}
>
  <div class="game-card__media">
    <img
      src={game.cover}
      alt={`Обложка игры «${game.title}»`}
      width="900"
      height="714"
      loading={index < 3 ? "eager" : "lazy"}
    />
    {
      game.browser && (
        <span class="game-card__badge">
          <span class="dot" aria-hidden="true"></span>
          В браузере
        </span>
      )
    }
  </div>

  <div class="game-card__body">
    <div class="game-card__meta">
      <span>{game.genre}</span>
      <span>{game.platforms.join(" / ")}</span>
    </div>
    <h3>{game.title}</h3>
    <p>{game.tagline}</p>
    <div class="game-card__foot">
      <span>Открыть игру</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</a>
