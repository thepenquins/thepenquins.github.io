---
import "@fontsource/unbounded/600.css";
import "@fontsource/unbounded/800.css";
import "@fontsource/golos-text/400.css";
import "@fontsource/golos-text/500.css";
import "@fontsource/golos-text/600.css";
import unbounded800 from "@fontsource/unbounded/files/unbounded-cyrillic-800-normal.woff2?url";
import golos400 from "@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title = "Penquins Software",
  description = "Penquins Software — команда разработчиков игр из Антарктики. Небольшие игры и эксперименты в разных жанрах: от коротких джем-проектов до атмосферных историй.",
  image = "/og.jpg",
  imageAlt = "Penquins Software — игры из Антарктики",
  type = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://thepenquins.github.io");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070c12" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href={unbounded800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={golos400} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Penquins Software" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <div class="page-grid" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
