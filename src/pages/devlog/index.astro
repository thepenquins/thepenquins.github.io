---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGame } from "../../data/games";
import { formatLongDate } from "../../lib/dates";
import { getDevlogPosts } from "../../lib/devlog";

const posts = await getDevlogPosts();

const title = "Девлог — Penquins Software";
const description =
  "Заметки о разработке игр Penquins Software: находки, решения и мелочи, которые не попадают в описание.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Девлог</p>
      <h1>Заметки о разработке</h1>
      <p class="lead">
        Как рождаются игры: находки, ошибки и детали, которые не попадают
        в описание.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <ul class="devlog-list">
            {posts.map((post) => {
              const game = post.data.game ? getGame(post.data.game) : undefined;

              return (
                <li>
                  <a class="devlog-card" href={`/devlog/${post.id}/`}>
                    <time class="devlog-card__date" datetime={post.data.date.toISOString()}>
                      {formatLongDate(post.data.date)}
                    </time>
                    <h2 class="devlog-card__title">{post.data.title}</h2>
                    <p class="devlog-card__summary">{post.data.summary}</p>
                    <span class="devlog-card__foot">
                      <span>{game ? game.title : "Читать"}</span>
                      <span class="devlog-card__arrow" aria-hidden="true">
                        →
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="devlog-empty">
            <p>
              Здесь появятся заметки о разработке — от первых идей до релизов.
            </p>
            <a class="btn btn--ghost" href="/games/">
              Смотреть игры <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
