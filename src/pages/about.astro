---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coreTeam, otherMembers, stats } from "../data/games";
import { timeline } from "../data/timeline";
import { formatMonthYear } from "../lib/dates";

const title = "О команде — Penquins Software";
const description =
  "Penquins Software — команда разработчиков игр из Антарктики. Небольшие игры и эксперименты в разных жанрах: от коротких джем-проектов до атмосферных историй.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">О команде</p>
      <h1>Команда из Антарктики</h1>
      <p class="lead">
        Penquins Software — команда разработчиков игр. Так мы себя называем: где бы
        мы ни оказались, делаем игры с холодной головой и тёплым интересом к необычным
        идеям.
      </p>
    </div>
  </section>

  <section class="about-intro">
    <div class="container about-intro__grid">
      <div class="prose">
        <p>
          Мы делаем небольшие игры и эксперименты в разных жанрах: от коротких
          джем-проектов до атмосферных историй. Часть проектов родилась на джемах,
          часть — из желания проверить одну конкретную идею.
        </p>
        <p>
          Объединяет нас желание доводить смелые идеи до играбельного результата.
        </p>
      </div>

      <div class="about-facts" aria-label="Команда в цифрах">
        <div><strong>{stats.games}</strong><span>игр в каталоге</span></div>
        <div><strong>{stats.genres}</strong><span>жанров</span></div>
      </div>
    </div>
  </section>

  <section class="timeline" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="timeline-head">
        <div>
          <p class="eyebrow">Хронология</p>
          <h2 id="timeline-heading" class="timeline-title">История команды</h2>
        </div>
        <p class="timeline-lead">
          От первого джема до последних релизов — короткая хронология команды.
        </p>
      </div>

      <ol class="timeline-list">
        {timeline.map((entry) => (
          <li class="timeline-item">
            <div class="timeline-item__meta">
              <time class="timeline-item__date" datetime={entry.date}>
                {formatMonthYear(entry.date)}
              </time>
              <span class="timeline-item__tag">{entry.tag}</span>
            </div>
            <div class="timeline-item__body">
              <h3 class="timeline-item__title">
                <a href={entry.href}>{entry.title}</a>
              </h3>
              <p class="timeline-item__text">{entry.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="stack" aria-labelledby="stack-heading">
    <div class="container">
      <p class="eyebrow">Инструменты</p>
      <h2 id="stack-heading" class="stack-title">На чём мы делаем игры</h2>

      <div class="stack-card">
        <div class="stack-card__body">
          <span class="stack-card__label">Движок</span>
          <h3 class="stack-card__name">Godot Engine</h3>
          <p>
            Большую часть игр мы делаем на Godot Engine — свободном движке
            с открытым исходным кодом. Он помогает быстро проверять идеи
            и собирать игру под различные платформы.
          </p>
        </div>
        <a
          class="btn btn--ghost stack-card__link"
          href="https://godotengine.org"
          target="_blank"
          rel="noopener"
        >
          godotengine.org <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="team" aria-labelledby="team-heading">
    <div class="container">
      <p class="eyebrow">Люди</p>
      <h2 id="team-heading" class="team-title">Основной состав</h2>

      <ul class="core-team">
        {coreTeam.map((member) => (
          <li>
            <a
              class="core-member"
              href={member.url}
              target="_blank"
              rel="noopener"
              title={`${member.name} на itch.io`}
              aria-label={`${member.name} — ${member.role}, профиль на itch.io`}
            >
              <span class="core-member__role">{member.role}</span>
              <span class="core-member__name">{member.name}</span>
              <span class="core-member__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="team-subtitle">Участники проектов</h3>
      <ul class="members">
        {otherMembers.map((member) => (
          <li>
            <a
              class="member-chip"
              href={member.url}
              target="_blank"
              rel="noopener"
              title={`${member.name} на itch.io`}
              aria-label={`${member.name} на itch.io`}
            >
              {member.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
