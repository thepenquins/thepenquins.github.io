---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import { games, getOtherGames, getGameCredits } from "../../data/games";
import type { Game } from "../../data/games";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const credits = getGameCredits(game);
const otherGames = getOtherGames(game.slug, 3);
const primaryHref = game.playUrl ?? game.itchUrl;
const isExternal = !game.playUrl;
const primaryLabel = game.playUrl ? "Играть" : "itch.io";

const canonical = new URL(`/games/${game.slug}/`, Astro.site);
const cover = new URL(game.cover, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: game.title,
  description: game.description.join(" "),
  genre: game.genre,
  url: canonical.href,
  image: cover.href,
  applicationCategory: "Game",
  operatingSystem: game.platforms.join(", "),
  author: {
    "@type": "Organization",
    name: "Penquins Software",
    url: Astro.site?.href,
  },
};
---

<BaseLayout
  title={`${game.title} — Penquins Software`}
  description={game.description[0]}
  image={`/og/${game.slug}.jpg`}
  imageAlt={`Обложка игры «${game.title}» — Penquins Software`}
  type="article"
>
  <article class="game-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Хлебные крошки">
        <a href="/games/">Игры</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{game.title}</span>
      </nav>

      <div class="game-hero">
        <div class="game-hero__cover">
          <img
            src={game.cover}
            alt={`Обложка игры «${game.title}»`}
            width="900"
            height="714"
            loading="eager"
          />
        </div>

        <div class="game-hero__info">
          <p class="eyebrow">
            {game.genre}{game.browser && " · в браузере"}
          </p>
          <h1 class="game-title">{game.title}</h1>
          <p class="game-tagline">{game.tagline}</p>

          <div class="game-actions">
            <a
              class="btn btn--primary"
              href={primaryHref}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener" : undefined}
            >
              {primaryLabel}
              <span class="btn__arrow" aria-hidden="true">{isExternal ? "↗" : "→"}</span>
            </a>
            {
              game.vkPlayUrl && (
                <a
                  class="btn btn--ghost"
                  href={game.vkPlayUrl}
                  target="_blank"
                  rel="noopener"
                >
                  VK Play <span class="btn__arrow" aria-hidden="true">↗</span>
                </a>
              )
            }
            {
              game.playUrl && (
                <a
                  class="btn btn--ghost"
                  href={game.itchUrl}
                  target="_blank"
                  rel="noopener"
                >
                  itch.io <span class="btn__arrow" aria-hidden="true">↗</span>
                </a>
              )
            }
            {
              game.sourceUrl && (
                <a
                  class="btn btn--ghost"
                  href={game.sourceUrl}
                  target="_blank"
                  rel="noopener"
                  title="Исходный код игры"
                >
                  Исходный код <span class="btn__arrow" aria-hidden="true">↗</span>
                </a>
              )
            }
          </div>

          <dl class="game-meta">
            <div>
              <dt>Жанр</dt>
              <dd>{game.genre}</dd>
            </div>
            <div>
              <dt>Платформы</dt>
              <dd>{game.platforms.join(", ")}</dd>
            </div>
            {
              game.jam && (
                <div>
                  <dt>Джем</dt>
                  <dd>{game.jam}</dd>
                </div>
              )
            }
            <div class="game-meta__authors">
              <dt>Авторы</dt>
              <dd>
                {credits.map((person) => (
                  <a
                    class="credit-chip"
                    href={person.url}
                    target="_blank"
                    rel="noopener"
                    title={`${person.name} на itch.io`}
                  >
                    {person.name}
                  </a>
                ))}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <section class="game-section" aria-labelledby="about-game">
        <h2 class="game-section__label" id="about-game">Об игре</h2>
        <div class="game-section__body">
          <div class="prose">
            {game.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {
            game.controls && (
              <p class="controls-box">
                <span class="sr-only">Управление: </span>
                {game.controls}
              </p>
            )
          }
        </div>
      </section>

      {
        game.screenshots.length > 0 && (
          <section class="game-section" aria-labelledby="screenshots">
            <h2 class="game-section__label" id="screenshots">Скриншоты</h2>
            <div class="game-section__body">
              <div class="gallery">
                {game.screenshots.map((screenshot, index) => (
                  <figure>
                    <a
                      class="gallery__link"
                      href={screenshot.src}
                      data-lightbox
                      aria-label={`Открыть скриншот ${index + 1} в полном размере`}
                    >
                      <img
                        src={screenshot.src}
                        alt={screenshot.alt}
                        width="1400"
                        height="788"
                        loading="lazy"
                      />
                      <span class="gallery__zoom" aria-hidden="true">⤢</span>
                    </a>
                  </figure>
                ))}
              </div>

              <dialog class="lightbox" data-lightbox-dialog aria-label="Просмотр скриншотов">
                <div class="lightbox__bar">
                  <span class="lightbox__counter" data-lightbox-counter></span>
                  <a
                    class="lightbox__source"
                    data-lightbox-source
                    href={game.screenshots[0].src}
                    target="_blank"
                    rel="noopener"
                  >
                    Открыть оригинал <span aria-hidden="true">↗</span>
                  </a>
                  <button
                    class="lightbox__close"
                    type="button"
                    data-lightbox-close
                    aria-label="Закрыть просмотр"
                  >
                    ✕
                  </button>
                </div>
                <div class="lightbox__stage">
                  <img
                    class="lightbox__img"
                    data-lightbox-img
                    src={game.screenshots[0].src}
                    alt={game.screenshots[0].alt}
                  />
                  {
                    game.screenshots.length > 1 && (
                      <>
                        <button
                          class="lightbox__nav lightbox__nav--prev"
                          type="button"
                          data-lightbox-prev
                          aria-label="Предыдущий скриншот"
                        >
                          ←
                        </button>
                        <button
                          class="lightbox__nav lightbox__nav--next"
                          type="button"
                          data-lightbox-next
                          aria-label="Следующий скриншот"
                        >
                          →
                        </button>
                      </>
                    )
                  }
                </div>
              </dialog>
            </div>
          </section>
        )
      }

      <section class="section" aria-labelledby="more-games">
        <div class="section-head">
          <div>
            <p class="eyebrow">Дальше</p>
            <h2 id="more-games">Другие игры</h2>
          </div>
          <a class="link-more" href="/games/">
            Весь каталог <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="games-grid">
          {otherGames.map((other, index) => <GameCard game={other} index={index} />)}
        </div>
      </section>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");

    if (dialog) {
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-lightbox]"));
      const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
      const source = dialog.querySelector<HTMLAnchorElement>("[data-lightbox-source]");
      const stage = dialog.querySelector<HTMLElement>(".lightbox__stage");
      const closeButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      const prevButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
      const nextButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]");
      let current = 0;

      const show = (index: number) => {
        current = (index + links.length) % links.length;
        const link = links[current];
        const thumbnail = link.querySelector("img");

        if (image && thumbnail) {
          image.src = link.href;
          image.alt = thumbnail.alt;
        }
        if (counter) {
          counter.textContent = `${current + 1} / ${links.length}`;
        }
        if (source) {
          source.href = link.href;
        }
      };

      links.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          event.preventDefault();
          show(index);
          dialog.showModal();
          document.body.classList.add("is-lightbox-open");
        });
      });

      closeButton?.addEventListener("click", () => dialog.close());
      prevButton?.addEventListener("click", () => show(current - 1));
      nextButton?.addEventListener("click", () => show(current + 1));

      stage?.addEventListener("click", (event) => {
        if (event.target === stage) {
          dialog.close();
        }
      });

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          show(current - 1);
        }
        if (event.key === "ArrowRight") {
          event.preventDefault();
          show(current + 1);
        }
      });

      dialog.addEventListener("close", () => {
        document.body.classList.remove("is-lightbox-open");
      });
    }
  </script>
</BaseLayout>
