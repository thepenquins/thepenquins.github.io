---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import { filterHref, games, genres, members, stats } from "../../data/games";

const title = "Игры — Penquins Software";
const description = `Каталог игр Penquins Software: ${stats.games} проектов и ${stats.genres} жанров. Скриншоты, управление и ссылки на сборки.`;
---

<BaseLayout
  title={title}
  description={description}
  image="/og/games.jpg"
  imageAlt="Все игры Penquins Software — каталог проектов"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Каталог · {stats.games} игр</p>
      <h1>Все игры</h1>
      <p class="lead">
        В каталоге — все проекты команды: эксперименты, короткие игры и работы с джемов.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filters">
        <div class="filters__toolbar">
          <div class="search">
            <label class="sr-only" for="game-search">Поиск по играм</label>
            <svg
              class="search__icon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <circle
                cx="11"
                cy="11"
                r="7"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></circle>
              <path
                d="m16.5 16.5 4 4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            <input
              id="game-search"
              class="search__input"
              type="search"
              name="q"
              placeholder="Найти игру"
              autocomplete="off"
              spellcheck="false"
              data-search
            />
            <button
              class="search__clear"
              type="button"
              data-search-clear
              aria-label="Очистить поиск"
              hidden
            >
              ✕
            </button>
          </div>

          <button class="btn btn--ghost filters__random" type="button" data-random hidden>
            Случайная игра <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </div>

        <div class="filters__row" role="group" aria-label="Фильтр по жанру">
          <span class="filters__label">Жанр</span>
          {
            genres.map((genre) => (
              <a
                class="filter-chip"
                href={filterHref("genre", genre)}
                data-filter="genre"
                data-value={genre}
              >
                {genre}
              </a>
            ))
          }
        </div>

        <div class="filters__row" role="group" aria-label="Фильтр по автору">
          <span class="filters__label">Автор</span>
          {
            members.map((member) => (
              <a
                class="filter-chip"
                href={filterHref("author", member.name)}
                data-filter="author"
                data-value={member.name}
              >
                {member.name}
              </a>
            ))
          }
        </div>

        <div class="filters__status" data-filter-status aria-live="polite" hidden>
          <span data-filter-summary></span>
          <a class="filter-chip filter-chip--reset" href="/games/" data-filter-reset>
            Сбросить
          </a>
        </div>

        <noscript>
          <p class="filters__note">
            Для поиска и фильтрации нужен JavaScript — ниже показаны все игры.
          </p>
        </noscript>
      </div>

      <div class="games-grid" data-games-grid>
        {games.map((game, index) => <GameCard game={game} index={index} />)}
      </div>

      <p class="filters__empty" data-filter-empty hidden>
        Ничего не нашлось. <a href="/games/">Показать все игры</a>.
      </p>
    </div>
  </section>

  <script is:inline>
  (() => {
    const grid = document.querySelector("[data-games-grid]");
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll("[data-game]"));
    const status = document.querySelector("[data-filter-status]");
    const summary = document.querySelector("[data-filter-summary]");
    const empty = document.querySelector("[data-filter-empty]");
    const chips = Array.from(document.querySelectorAll("[data-filter]"));
    const search = document.querySelector("[data-search]");
    const searchClear = document.querySelector("[data-search-clear]");
    const random = document.querySelector("[data-random]");
    const total = cards.length;

    const normalize = (value) => value.toLowerCase().replace(/ё/g, "е").trim();

    const apply = () => {
      const params = new URLSearchParams(window.location.search);
      const genre = params.get("genre");
      const author = params.get("author");
      const query = params.get("q") ?? "";
      const tokens = normalize(query).split(/\s+/).filter(Boolean);
      let shown = 0;

      cards.forEach((card) => {
        const genreOk = !genre || card.dataset.genre === genre;
        const authors = (card.dataset.authors || "").split("|");
        const authorOk = !author || authors.indexOf(author) !== -1;
        const haystack = normalize(card.dataset.search || "");
        const searchOk = tokens.every((token) => haystack.includes(token));
        const visible = genreOk && authorOk && searchOk;

        card.hidden = !visible;
        if (visible) shown += 1;
      });

      chips.forEach((chip) => {
        const requested = chip.dataset.filter === "genre" ? genre : author;
        const active = chip.dataset.value === requested;

        chip.classList.toggle("is-active", active);
        if (active) {
          chip.setAttribute("aria-current", "true");
        } else {
          chip.removeAttribute("aria-current");
        }
      });

      const active = Boolean(genre || author || tokens.length);

      if (status) status.hidden = !active;

      if (summary) {
        const parts = [];
        if (genre) parts.push("Жанр: " + genre);
        if (author) parts.push("Автор: " + author);
        if (tokens.length) parts.push("Поиск: «" + query.trim() + "»");
        summary.textContent = parts.join(" · ") + " — " + shown + " из " + total;
      }

      if (empty) empty.hidden = !active || shown > 0;

      if (search && search.value !== query) search.value = query;
      if (searchClear) searchClear.hidden = !query;
    };

    const setQuery = (value) => {
      const params = new URLSearchParams(window.location.search);

      if (value.trim()) {
        params.set("q", value);
      } else {
        params.delete("q");
      }

      const query = params.toString();
      window.history.replaceState(
        null,
        "",
        query ? `${window.location.pathname}?${query}` : window.location.pathname,
      );
      apply();
    };

    document.addEventListener("click", (event) => {
      const link = event.target.closest("[data-filter], [data-filter-reset]");

      if (!link || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      event.preventDefault();
      window.history.pushState(null, "", link.href);
      apply();
    });

    search?.addEventListener("input", () => setQuery(search.value));
    search?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && search.value) {
        event.preventDefault();
        search.value = "";
        setQuery("");
      }
    });

    searchClear?.addEventListener("click", () => {
      if (!search) return;
      search.value = "";
      setQuery("");
      search.focus();
    });

    if (random) {
      random.hidden = false;
      random.addEventListener("click", () => {
        const visible = cards.filter((card) => !card.hidden);
        const pool = visible.length ? visible : cards;
        const card = pool[Math.floor(Math.random() * pool.length)];

        if (card) window.location.assign(card.href);
      });
    }

    window.addEventListener("popstate", apply);
    apply();
  })();
  </script>
</BaseLayout>
